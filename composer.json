{
    "name": "caiquebispo/banco-do-brasil",
    "description": "PHP SDK para as APIs do Banco do Brasil — Cobrança (Boletos), PIX, Pagamentos em Lote e Extratos com suporte multi-conta",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Caique Bispo",
            "email": "caiquebispodanet86@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "illuminate/support": "Para integração automática com Laravel (ServiceProvider + Facade)"
    },
    "autoload": {
        "psr-4": {
            "CaiqueBispo\\BancoDoBrasil\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CaiqueBispo\\BancoDoBrasil\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CaiqueBispo\\BancoDoBrasil\\Laravel\\BancoDoBrasilServiceProvider"
            ],
            "aliases": {
                "BB": "CaiqueBispo\\BancoDoBrasil\\Laravel\\Facades\\BB"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text"
    },
    "minimum-stability": "stable"
}
